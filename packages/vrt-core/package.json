{
  "name": "vrt-core",
  "version": "0.0.0",
  "private": true,
  "description": "Internal shared VRT primitives (pixel diff, git ref access). Bundled into the addons; never published.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "check:write": "vp check --fix"
  },
  "dependencies": {
    "pixelmatch": "catalog:",
    "pngjs": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
